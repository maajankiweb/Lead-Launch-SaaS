# ==============================================================================
# LEAD & LAUNCH SAAS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy and rename this file to .env.local (or set in Vercel Project Settings)
# ==============================================================================

# MongoDB Atlas Cloud Database (Required for multi-tenant accounts & campaigns)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/lead_to_launch?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/lead_to_launch?retryWrites=true&w=majority"

# JWT Secret for High-Security Session Tokens (Required - minimum 32 random characters)
JWT_SECRET="generate-a-secure-random-32-char-jwt-secret-key-here"

# Super Admin Credentials (Optional - overrides default root credentials)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongAdminPasswordHere!"
ADMIN_NAME="Super Admin"

# Apify Token for Live Google Places Leads Scraping (Optional - automatic demo fallback active if omitted)
APIFY_TOKEN="apify_api_your_token_here"
APIFY_ACTOR="compass~crawler-google-places"

# Deployment Production URL (Replace with your custom domain or vercel.app domain)
NEXT_PUBLIC_APP_URL="https://lead-launch-saas.vercel.app"

# ==============================================================================
# PAYMENT GATEWAY KEYS (Optional - instant test upgrades active if omitted)
# ==============================================================================

# Razorpay (India INR & International Cards)
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"

# Stripe (Global Credit Cards & Subscriptions)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# ==============================================================================
# AUDITING & AI ENGINE KEYS (Optional)
# ==============================================================================

# Google PageSpeed Insights API Key for Core Web Vitals Audit
PAGESPEED_API_KEY=""

# Anthropic Claude API Key (Optional - local claude CLI auto-detected if installed)
ANTHROPIC_API_KEY=""
CLAUDE_CLI_PATH=""
