# ==============================================================================
# LEAD & LAUNCH SAAS - VERCEL ENVIRONMENT VARIABLES CONFIGURATION
# Copy and paste these into your Vercel Project Dashboard (Settings -> Environment Variables)
# ==============================================================================

# MongoDB Atlas Cloud Database (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lead_to_launch?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lead_to_launch?retryWrites=true&w=majority"

# JWT Secret for High-Security Session Tokens (Required)
JWT_SECRET="lead-to-launch-jwt-secret-secure-key-2026"

# Apify Token for Live Google Places Leads Scraping (Optional - fallback seed active if missing)
APIFY_TOKEN="your_apify_api_token_here"
APIFY_ACTOR="compass~crawler-google-places"

# Deployment Production URL (Replace with your custom domain or vercel.app domain)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://lead-to-launch.vercel.app"
